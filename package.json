{
  "name": "tg-antispam-bot",
  "version": "1.0.0",
  "description": "VahterBot — Anti-spam Telegram bot",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "healthcheck": "node dist/healthcheck.js",
    "lint": "eslint src/ test/",
    "test": "node --test --test-concurrency=1 --import tsx test/**/*.test.ts",
    "check": "npm run lint && tsc --noEmit && npm test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "grammy": "^1.45.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "tsx": "^4.23.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
