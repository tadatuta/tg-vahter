{
  "name": "tg-antispam-bot",
  "version": "1.0.0",
  "description": "VahterBot — Anti-spam Telegram bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "deploy": "rm -rf dist && npm run build && cp package* voyahchat-antispam-encoded.txt dist/ && cd dist && zip -r ../dist.zip . && cd ..",
    "dev": "tsx --env-file=.env src/index.ts",
    "lint": "eslint src/",
    "test": "node --test --test-concurrency=1 --import tsx test/**/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "grammy": "^1.35.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.4",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.0"
  }
}