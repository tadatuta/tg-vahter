# Required: Telegram bot token from @BotFather
BOT_TOKEN=

# Required: Comma-separated Telegram user IDs of super-admins
ADMIN_IDS=

# Required: Regex pattern for spam detection (case-insensitive)
SPAM_REGEX=

# Optional: Path to SQLite database file (default: /tmp/vahter.db)
DB_PATH=/tmp/vahter.db

# Optional: Path to log file (default: /tmp/vahter.log)
LOG_FILE=/tmp/vahter.log
