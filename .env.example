# Production runtime
NODE_ENV=production

# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated global bot owner IDs
SUPER_ADMIN_IDS=

# Required in production. HTTP(S) proxy without authentication is supported.
TELEGRAM_PROXY_URL=https://proxy.example.com:443

# Separate Telegram chat for operational alerts
ALERT_CHAT_ID=

# SQLite lives on the local Docker volume
DB_PATH=/data/vahter.db

# Regex is baked into the image from the repository
SPAM_REGEX_FILE=/app/voyahchat-antispam-encoded.txt

# info, warn, or error
LOG_LEVEL=info
